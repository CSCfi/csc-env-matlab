Bootstrap: docker
From: rockylinux/rockylinux:9.8

%files
    base-dependencies.txt /opt/base-dependencies.txt
    mpm_input.txt /opt/mpm_input.txt

%post
    # Add fake commands
    cp /usr/bin/true /usr/sbin/useradd
    cp /usr/bin/true /usr/sbin/groupadd

    # Build environment
    export LANG=en_us.UTF-8
    export TZ="Etc/UTC"

    # Install dependencies
    dnf update -y
    dnf install -y --allowerasing $(cat /opt/base-dependencies.txt)
    dnf clean all -y

    [ -d /usr/share/X11/xkb ] || mkdir -p /usr/share/X11/xkb

    # TODO: Install MATLAB

    # Install MATLAB Proxy
    dnf install -y epel-release
    dnf install -y python3.14 python3.14-pip xorg-x11-server-Xvfb openbox
    dnf clean all -y
    python3.14 -m venv /opt/venv
    export PATH=/opt/venv/bin:$PATH
    python3 -m pip install --upgrade pip
    python3 -m pip install --no-cache-dir matlab-proxy==0.36.0

%environment
    export LANG=en_us.UTF-8
    export TZ="Etc/UTC"
    export PYTHONNOUSERSITE="1"
    export PATH=/opt/venv/bin:$PATH
