#!/bin/bash

# Path to image file. Defaults to CSC image.
: "${MATLAB_SIF_IMAGE:="{{ appl_dir }}/matlab/{{ version }}/matlab.sif"}"

# Avoid passing LD_PRELOAD into Apptainer
export APPTAINERENV_LD_PRELOAD=""

# Exec matlab container
apptainer --silent exec \
    --bind="/run/user" \
    --bind="/users,/projappl,/scratch,/dataset,/sbf,$TMPDIR,$LOCAL_SCRATCH" \
    --bind="{{ appl_dir }}/mathworks/servicehost/mathworksservicehost.sqfs:/opt/mathworksservicehost:image-src=/" \
    --env="MATHWORKS_SERVICE_HOST_MANAGED_INSTALL_ROOT=/opt/mathworksservicehost" \
    --nv \
    "${MATLAB_SIF_IMAGE}" "$@"
