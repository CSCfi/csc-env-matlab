#!/bin/bash

# Path to image file. Defaults to CSC image.
: "${MATLAB_SIF_IMAGE:="/appl/local/csc/soft/math/matlab/{{ version }}/matlab.sif"}"

export SINGULARITYENV_PREPEND_PATH=/opt/matlab/bin:

# Exec matlab container
singularity --silent exec \
    --bind="/run/user" \
    --bind="/pfs,/users,/projappl,/scratch,/project,/flash,$TMPDIR,$LOCAL_SCRATCH" \
    --bind="{{ appl_dir }}/mathworks/servicehost/mathworksservicehost.sqfs:/opt/mathworksservicehost:image-src=/" \
    --env="MATHWORKS_SERVICE_HOST_MANAGED_INSTALL_ROOT=/opt/mathworksservicehost" \
    "${MATLAB_SIF_IMAGE}" "$@"
