Bootstrap: docker
From: rockylinux/rockylinux:9.8

%files
    base-dependencies.txt /opt/base-dependencies.txt
    mpm_input.txt /opt/mpm_input.txt

%post
    # Add fake commands
    cp /usr/bin/true /usr/sbin/useradd
    cp /usr/bin/true /usr/sbin/groupadd

    # Build environment
    export LANG=en_us.UTF-8
    export TZ="Etc/UTC"

    # Install dependencies
    dnf update -y
    dnf install -y --allowerasing $(cat /opt/base-dependencies.txt)
    dnf install -y --allowerasing gcc gcc-c++ gcc-gfortran

    [ -d /usr/share/X11/xkb ] || mkdir -p /usr/share/X11/xkb

    # TODO: Install MATLAB
    dnf install -y --allowerasing curl ca-certificates

    # Clean packages at the end of the build.
    dnf clean all -y

%environment
    export LANG=en_us.UTF-8
    export TZ="Etc/UTC"
    export PYTHONNOUSERSITE="1"
    export PATH=/opt/venv/bin:$PATH
